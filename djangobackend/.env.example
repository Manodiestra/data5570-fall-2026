# Copy this file to .env for local development. On Render, set these as
# environment variables on the web service instead (render.yaml prompts for them).

# Supabase dashboard: Project Settings -> Data API -> Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional locally: leave unset to use db.sqlite3. To use Supabase Postgres,
# copy the "Session pooler" connection string from the dashboard's Connect
# button and fill in your database password.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
