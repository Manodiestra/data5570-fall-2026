# Copy this file to .env and fill in the values.
# Find them in the Supabase dashboard: Project Settings -> API Keys.
# EXPO_PUBLIC_ vars are bundled into the client, so only use the
# publishable (anon) key here -- never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
